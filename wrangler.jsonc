{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dernslow",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dernslow-db",
    "database_id": "31bf0a4a-1c8b-40db-9c12-7bad01297fc5",
    "migrations_dir": "./migrations"
  }],
  "r2_buckets": [{
    "binding": "FILES",
    "bucket_name": "dernslow-files"
  }],
  "durable_objects": {
    "bindings": [{"name": "RESERVATIONS", "class_name": "ReservationExpiry"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReservationExpiry"]}],
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
